# Copiá este archivo a ".env" para probar en tu PC con "npm start".
# En Render estas mismas variables se cargan desde el panel (Environment), no desde este archivo.

# Datos de tu base en Turso (ver server/README.md, paso 1)
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=pega-aca-tu-token-de-turso

# Clave secreta que vos vas a usar en el launcher para poder bloquear/eliminar gente.
# Inventá algo largo y random. NO la compartas ni la subas a un repo público.
ADMIN_KEY=elegi-una-clave-larga-y-secreta

# Opcional: segundos sin heartbeat antes de mostrar a alguien como "desconectado"
ONLINE_WINDOW_SECONDS=150
